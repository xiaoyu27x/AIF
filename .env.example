# Required in production: use a long random value, never commit the real value.
SESSION_SECRET=replace-with-a-long-random-secret

# Optional first administrator created on first startup.
ADMIN=admin
ADMIN_PASSWORD=change-this-password

# Model provider: ollama uses an OpenAI-compatible local endpoint; openai uses a hosted API.
AI_PROVIDER=ollama
LLM_URL=http://127.0.0.1:8000/v1/chat/completions

# Hosted OpenAI-compatible provider. Keep the key only in an environment variable or secret manager.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Optional email verification delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional voice service endpoint.
VOICE_URL=http://127.0.0.1:8010
