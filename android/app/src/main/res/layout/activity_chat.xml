<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/chatRoot" android:orientation="vertical" android:background="@color/ink" android:padding="10dp" android:paddingBottom="30dp" android:fitsSystemWindows="true" android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:id="@+id/chatHeader" android:orientation="horizontal" android:gravity="top" android:background="#271D38" android:padding="10dp" android:layout_width="match_parent" android:layout_height="120dp">
    <ImageView android:id="@+id/avatar" android:layout_gravity="top" android:layout_marginTop="10dp" android:scaleType="centerCrop" android:background="@drawable/avatar_circle" android:clipToOutline="true" android:layout_width="84dp" android:layout_height="84dp"/>
    <LinearLayout android:orientation="vertical" android:paddingStart="12dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent">
      <TextView android:id="@+id/roleName" android:textColor="@color/white" android:textSize="23sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
      <Spinner android:id="@+id/roleSpinner" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"/>
      <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="5dp" android:layout_width="match_parent" android:layout_height="wrap_content"><TextView android:id="@+id/relationship" android:textColor="#F2CAE0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/><Button android:id="@+id/conversationMode" android:text="连续模式" android:textSize="11sp" android:minHeight="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_width="wrap_content" android:layout_height="34dp"/></LinearLayout>
      <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="42dp"><Button android:id="@+id/changeAvatar" android:text="换头像" android:textSize="12sp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/><Button android:id="@+id/editRole" android:text="编辑对象" android:textSize="12sp" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/><Button android:id="@+id/leaveChat" android:text="退出聊天" android:textSize="12sp" android:layout_marginStart="5dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"/></LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <ScrollView android:id="@+id/scroll" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/messages" android:orientation="vertical" android:padding="4dp" android:layout_width="match_parent" android:layout_height="wrap_content"/></ScrollView>
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="-2dp" android:layout_width="match_parent" android:layout_height="52dp"><EditText android:id="@+id/message" android:layout_marginTop="1dp" android:gravity="center_vertical" android:hint="说点什么…" android:textColor="@color/white" android:textColorHint="#CBBFD1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"/><Button android:id="@+id/send" android:text="发送" android:layout_marginStart="6dp" android:layout_width="wrap_content" android:layout_height="48dp"/></LinearLayout>
  <Button android:id="@+id/project" android:text="项目控制" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
